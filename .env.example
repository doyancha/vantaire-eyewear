# VANTAIRE EYEWEAR Environment Variables Template

# Supabase Connectivity
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storefront Data Source Configuration ('static' | 'supabase')
# Phase 5 cutover uses 'supabase' in local development environment.
VANTAIRE_STOREFRONT_DATA_SOURCE=supabase
VANTAIRE_ALLOW_STATIC_FALLBACK=false

# Optional Site URL Override
NEXT_PUBLIC_SITE_URL=http://localhost:3000
